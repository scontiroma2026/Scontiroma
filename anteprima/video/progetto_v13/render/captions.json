[{"a": 0.0, "b": 1.23, "h": "Hai un'attività a <b class=f>Roma?</b>"}, {"a": 1.56, "b": 3.2, "h": "Ti spiego in pochi secondi"}, {"a": 3.2, "b": 5.22, "h": "come portare <b class=c>nuovi clienti</b> nel tuo negozio."}, {"a": 5.64, "b": 7.5, "h": "Sconti Roma è <b class=f>un'app nuova,</b>"}, {"a": 7.5, "b": 9.53, "h": "nata a Roma per i <b class=c>negozi di quartiere.</b>"}, {"a": 9.83, "b": 11.35, "h": "Stiamo partendo adesso a"}, {"a": 11.35, "b": 13.4, "h": "<b class=c>Roma e dintorni,</b>"}, {"a": 13.4, "b": 14.9, "h": "e cerchiamo le <b class=f>prime attività</b>"}, {"a": 14.9, "b": 16.16, "h": "con cui costruirla insieme."}, {"a": 16.5, "b": 17.22, "h": "Funziona così:"}, {"a": 17.5, "b": 19.3, "h": "i romani trovano nell'app i negozi"}, {"a": 19.3, "b": 21.23, "h": "del <b class=c>loro quartiere</b> che offrono <b class=f>sconti.</b>"}, {"a": 21.54, "b": 22.9, "h": "Tu scegli un <b class=f>prodotto</b> o un"}, {"a": 22.9, "b": 24.39, "h": "<b class=f>servizio</b> della tua attività."}, {"a": 24.66, "b": 26.4, "h": "Decidi di <b class=c>quanto scontarlo,</b> in"}, {"a": 26.4, "b": 28.2, "h": "<b class=c>quali giorni</b> vale e <b class=c>quante</b>"}, {"a": 28.2, "b": 30.04, "h": "<b class=c>volte al mese</b> ogni cliente può usarlo."}, {"a": 30.28, "b": 31.5, "h": "<b class=f>Le regole le fai tu.</b>"}, {"a": 31.85, "b": 32.72, "h": "Facciamo un esempio:"}, {"a": 33.0, "b": 34.3, "h": "una trattoria ha il <b class=f>menù di</b>"}, {"a": 34.3, "b": 35.56, "h": "<b class=f>pesce</b> a quaranta euro."}, {"a": 35.78, "b": 37.5, "h": "Decide di <b class=c>scontarlo</b>"}, {"a": 37.5, "b": 39.0, "h": "<b class=c>il mercoledì e il venerdì,</b>"}, {"a": 39.0, "b": 41.0, "h": "una volta al mese a persona."}, {"a": 41.23, "b": 43.0, "h": "Il cliente lo paga <b class=f>venti euro,</b>"}, {"a": 43.0, "b": 45.43, "h": "e la trattoria riempie i <b class=c>giorni più tranquilli.</b>"}, {"a": 45.74, "b": 47.1, "h": "Il cliente ti mostra il <b class=f>codice</b>"}, {"a": 47.1, "b": 48.47, "h": "<b class=f>QR</b> sul telefono,"}, {"a": 48.71, "b": 50.61, "h": "tu lo <b class=c>inquadri</b> e applichi lo sconto."}, {"a": 50.89, "b": 51.5, "h": "Tutto qui."}, {"a": 51.72, "b": 52.61, "h": "E quanto costa?"}, {"a": 52.89, "b": 54.71, "h": "Durante la fase di lancio, <b class=f>niente.</b>"}, {"a": 54.98, "b": 57.75, "h": "Poi <b class=f>4,99 € al mese,</b> IVA inclusa,"}, {"a": 57.75, "b": 60.19, "h": "con il <b class=c>prezzo bloccato</b> per chi parte adesso."}, {"a": 60.45, "b": 62.25, "h": "Ti avvisiamo <b class=c>30 giorni prima,</b>"}, {"a": 62.25, "b": 64.45, "h": "e non paghi nulla <b class=f>senza la tua conferma.</b>"}, {"a": 64.73, "b": 67.73, "h": "<b class=f>Mantieni lo sconto</b> fino a fine mese,"}, {"a": 67.73, "b": 69.34, "h": "poi decidi tu se rinnovarlo."}, {"a": 69.62, "b": 71.0, "h": "Quello che ci guadagni è"}, {"a": 71.0, "b": 72.6, "h": "<b class=c>visibilità</b> nel tuo quartiere e"}, {"a": 72.6, "b": 74.37, "h": "<b class=f>nuovi clienti</b> che vengono a trovarti."}, {"a": 74.63, "b": 76.54, "h": "Per iscriverti bastano <b class=c>pochi minuti.</b>"}, {"a": 76.75, "b": 79.3, "h": "Scrivici a <b class=c>info@scontiroma.it,</b>"}, {"a": 79.3, "b": 81.6, "h": "e ti aiutiamo a partire."}]